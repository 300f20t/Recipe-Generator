{
	"schemaVersion": 1,
	"id": "recipe_generator",
	"version": "${version}",
	"name": "Recipe Generator",
	"description": "The Recipe Generator mod provides a visual recipe editor in Minecraft.",
	"authors": [
		"300f20t"
	],
	"contact": {
		"homepage": "https://github.com/300f20t/Recipe-Generator"
	},
	"license": "MIT",
	"icon": "assets/recipe_generator/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.recipe_generator.RecipeGenerator"
		],
		"client": [
			"com.recipe_generator.client.RecipeGeneratorClient"
		]
	},
		"mixins": [
		"recipe_generator.mixins.json",
		{
			"config": "recipe_generator.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
